{
  "name": "@ingestron/connectors",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "runtime:test": "build/singer-github/bin/python -m unittest discover -s test/runtime -v",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "secrets:check": "node scripts/secrets.mjs",
    "validate": "pnpm format:check && pnpm build && pnpm test && pnpm runtime:test && pnpm docs:check && pnpm secrets:check",
    "runtime:prepare": "node scripts/prepare-python.mjs",
    "acceptance": "build/singer-github/bin/python scripts/installed-acceptance.py",
    "acceptance:files": "python3 scripts/files-acceptance.py",
    "acceptance:files:tables": "build/singer-github/bin/python scripts/files-table-acceptance.py",
    "acceptance:retail": "python3 scripts/retail-current-acceptance.py",
    "package:retail": "python3 scripts/package-retail.py",
    "acceptance:azure-blob": "build/singer-github/bin/python scripts/azure-blob-acceptance.py",
    "acceptance:sql-server:live": "python3 scripts/sql-server-live-acceptance.py"
  },
  "devDependencies": {
    "ingestron": "0.15.1",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  },
  "description": "Independently versioned source packages for Ingestron.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/connectors.git"
  }
}
